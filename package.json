{
  "name": "kopo-next",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:web": "pnpm --filter @kopo/web build",
    "build:api": "pnpm --filter @kopo/api build",
    "test": "node scripts/test-api.mjs",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "export:site": "node scripts/export-site.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0",
    "mongodb-memory-server": "^10.3.0"
  },
  "packageManager": "pnpm@11.25.0"
}